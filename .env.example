# Supabase. Both are NEXT_PUBLIC_ because they are sent to the browser by
# design: the security boundary is row level security in supabase/schema.sql,
# not key secrecy. Never add the service-role key here or anywhere under app/.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Either name works. Supabase renamed this key from "anon" to "publishable",
# and its Vercel integration has created both over time, so lib/supabase/config.ts
# accepts whichever is present rather than failing on the older name.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
